# ---------------------------------------------------------------------------
# QuickBite Order Processing System — environment configuration template
# Copy to `.env` and adjust. Never commit a real `.env` with secrets.
# ---------------------------------------------------------------------------

# Database (SQLAlchemy URL). Use PostgreSQL in Docker, SQLite for local dev.
DATABASE_URL=postgresql+asyncpg://quickbite:quickbite@localhost:5432/quickbite
# DATABASE_URL=sqlite+aiosqlite:///./quickbite.db

# RabbitMQ connection URL
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- Reliability tuning ----------------------------------------------------
# Maximum delayed retries before a message goes to the dead-letter queue.
MAX_RETRIES=3
# Base delay (seconds) for the first retry; doubles on each attempt (5, 10, 20...).
RETRY_BASE_DELAY_SECONDS=5
# RabbitMQ consumer prefetch count (QoS) per worker instance.
PREFETCH_COUNT=5

# --- Payment simulation ----------------------------------------------------
# random | never_fail | always_fail | fail_twice
# Can be overridden per order via the `payment_behavior` field of POST /orders.
PAYMENT_FAILURE_MODE=random
# Probability of a transient payment failure when mode=random.
PAYMENT_FAILURE_RATE=0.25
# Simulated payment processing latency window (seconds).
PAYMENT_MIN_DELAY_SECONDS=0.5
PAYMENT_MAX_DELAY_SECONDS=2.0

# Simulated restaurant confirmation / driver assignment latency (seconds).
RESTAURANT_DELAY_SECONDS=1.0
DELIVERY_DELAY_SECONDS=1.0

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Docker Compose only ---------------------------------------------------
POSTGRES_PASSWORD=change-me  # used only by docker-compose; keep secret in .env
RABBITMQ_USER=quickbite
RABBITMQ_PASSWORD=change-me  # used only by docker-compose; keep secret in .env
